rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /favorites/{idMeal} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /custom_recipes/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
